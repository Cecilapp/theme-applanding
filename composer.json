{
  "name": "cecil/theme-applanding",
  "type": "cecil-theme",
  "description": "Cecil theme: App Landing",
  "keywords": ["Cecil", "theme", "landing", "Tailwind CSS"],
  "license": "MIT",
  "require": {
    "cecil/theme-installer": "^2.1",
    "cecil/theme-ogimage": "^1.3"
  },
  "require-dev": {
    "aligny/tailwind-builder": "^1.2.3"
  },
  "extra": {
    "cecil": {
      "theme-name": "applanding"
    },
    "branch-alias": {
      "dev-main": "1.x-dev"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "cecil/theme-installer": true
    }
  },
  "scripts": {
    "css:build": "tailwind-builder assets/tailwind.css --output=assets/styles.css --minify",
    "css:watch": "tailwind-builder assets/tailwind.css --output=assets/styles.css --watch"
  }
}
