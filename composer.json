{
  "name": "cecil/theme-applanding",
  "type": "cecil-theme",
  "description": "Cecil theme: App Landing",
  "keywords": ["Cecil", "theme", "landing"],
  "license": "MIT",
  "require": {
    "cecil/theme-installer": "^1.4|^2.0"
  },
  "extra": {
    "name": "applanding",
    "branch-alias": {
      "dev-master": "1.x-dev"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "cecil/theme-installer": true
    }
  },
  "require-dev": {
    "aligny/tailwind-builder": "^1.2"
  },
  "scripts": {
    "css:build": "tailwind-builder assets/tailwind.css --output=assets/styles.css --minify",
    "css:watch": "tailwind-builder assets/tailwind.css --output=assets/styles.css --watch"
  }
}
