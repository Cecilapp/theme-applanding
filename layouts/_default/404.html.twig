{% extends ['page.html.twig', '_default/page.html.twig'] %}

        {%- block main ~%}
        <div class="grow flex flex-col items-center justify-center text-center">
          {%- if page.content is not empty ~%}
          {{ page.content }}
          {%- else ~%}
          <p class="text-7xl md:text-9xl font-bold text-slate-200 dark:text-slate-700 slide-in-bottom" aria-hidden="true">404</p>
          <h1>{% trans %}Page not found{% endtrans %}</h1>
          <p class="md:text-xl">{% trans %}Looks like you've followed a broken link or entered a URL that doesn't exist on this site.{% endtrans %}</p>
          <p class="mt-4"><a href="{{ url(site.home) }}" class="font-medium underline">{% trans %}Back to home page{% endtrans %}</a></p>
          {%- endif ~%}
        </div>
        {%- endblock main ~%}