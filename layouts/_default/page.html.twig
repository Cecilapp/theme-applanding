<!DOCTYPE html>
<html lang="{{ site.language }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {#- dark mode toggle, if the `darkmodetoggle` theme is installed ~#}
    {{- include('partials/darkmodetoggle-head.html.twig', {site}, with_context = false, ignore_missing = true) }}
    {#- the Open Graph image is generated by the `ogimage` theme ~#}
    {{- include('partials/metatags.html.twig', {page, site, image: og_image(page)}, with_context = false) }}
    {%- block head_css ~%}
    {{ html(asset('styles.css')) }}
    {#- code highlighting (enabled by default) ~#}
    {%- set highlight = config.pages.body.highlight ?? true ~%}
    {%- if highlight is iterable ? (highlight.enabled ?? true) : highlight ~%}
    <style>{{ include('partials/highlight.css.twig')|minify_css }}</style>
    {%- endif ~%}
    {%- endblock head_css ~%}
    {%- block head %}{% endblock head ~%}
  </head>
  <body class="leading-normal tracking-normal text-slate-900 dark:text-slate-300 bg-white dark:bg-slate-900">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:px-3 focus:py-2 focus:rounded focus:bg-slate-100 dark:focus:bg-slate-800">{% trans %}Skip to content{% endtrans %}</a>
    {#- the header and the footer fade in on the home page only ~#}
    {%- set fade_in = page.type == 'homepage' ~%}
    <div class="container mx-auto px-6 py-6 min-h-svh flex flex-col">
      {%- block header ~%}
      <header class="mb-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
          {#- title ~#}
          <div class="font-serif font-bold text-xl lg:text-2xl{{ fade_in ? ' fade-in' }}">
            {%- if page.type == 'homepage' ~%}
            {{ site.title }}
            {%- else ~%}
            <a href="{{ url(site.home) }}" class="hover:no-underline">{{ site.title }}</a>
            {%- endif ~%}
          </div>
          <div class="flex items-center justify-end gap-4{{ fade_in ? ' fade-in' }}">
            {#- menu ~#}
            {%- set entries = (site.menus.main ?? [])|sort_by_weight|filter(entry => entry.id != 'index') ~%}
            {%- if entries is not empty ~%}
            {%- set current_url = url(page) ~%}
            <nav aria-label="{% trans %}Main menu{% endtrans %}">
              <ul class="flex flex-wrap gap-4">
              {%- for entry in entries ~%}
                {%- set entry_url = url(entry.url) ~%}
                <li><a href="{{ entry_url }}" class="aria-[current=page]:font-bold"{% if entry_url == current_url %} aria-current="page"{% endif %}{% if entry.url is external %} rel="noopener"{% endif %}>{{ entry.name }}</a></li>
              {%- endfor ~%}
              </ul>
            </nav>
            {%- endif ~%}
            {#- languages: links to the translations of the page ~#}
            {%- if page.translations|default([]) is not empty ~%}
            <nav aria-label="{% trans %}Languages{% endtrans %}">
              <ul class="flex gap-2 text-sm font-medium uppercase">
              {%- for translation in page.translations ~%}
                <li><a href="{{ url(translation) }}" hreflang="{{ translation.language }}" lang="{{ translation.language }}" title="{{ site.language.name(translation.language) }}">{{ translation.language }}</a></li>
              {%- endfor ~%}
              </ul>
            </nav>
            {%- endif ~%}
            {%- block links ~%}
            {#- GitHub ~#}
            {%- if site.applanding.source|default ~%}
            <a class="inline-block hover:text-slate-700 dark:hover:text-slate-100" href="{{ url(site.applanding.source) }}" aria-label="{% trans %}Source code{% endtrans %}">
              <svg class="fill-current h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z"></path>
              </svg>
            </a>
            {%- endif ~%}
            {%- endblock links ~%}
            {{- include('partials/darkmodetoggle.html.twig', {class: 'hover:text-slate-700 dark:hover:text-slate-100'}, ignore_missing = true) }}
          </div>
        </div>
      </header>
      {%- endblock header ~%}
      <main id="main" class="grow flex flex-col">
        {%- block main ~%}
        <article class="prose prose-slate dark:prose-invert md:prose-lg max-w-3xl">
          {%- block content ~%}
          {{ page.content }}
          {%- endblock content ~%}
        </article>
        {%- endblock main ~%}
      </main>
      <footer class="mt-6 text-sm text-center md:text-left{{ fade_in ? ' fade-in' }}">
        {%- block footer ~%}
        <p class="text-slate-700 dark:text-slate-300">{% trans with {'%powered_by%': '<a href="' ~ cecil.url ~ '" class="underline">Cecil</a>'} %}Powered by %powered_by%{% endtrans %}</p>
        {%- endblock footer ~%}
      </footer>
    </div>
    {%- block scripts %}{% endblock scripts ~%}
  </body>
</html>