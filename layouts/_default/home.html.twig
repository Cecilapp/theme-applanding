{% extends ['page.html.twig', '_default/page.html.twig'] %}

        {%- block main ~%}
        <div class="grow items-center flex flex-col lg:flex-row gap-6">
          {#- text ~#}
          <div class="basis-1/2">
            <h1 id="baseline" class="leading-tight text-center md:text-left">{{ site.baseline }}</h1>
            <div id="content" class="leading-normal text-base md:text-2xl mb-8 text-center md:text-left">{{ page.content }}</div>
            <div id="buttons" class="flex w-full justify-center md:justify-start fade-in">
            {%- for button in site.applanding.buttons ~%}
              <a href="{{ button.url }}">
                {%- set class = 'md:h-12 w-full bounce-top-icons' -%}
                {%- if not loop.last -%}
                  {%- set class = class ~ ' pr-4' -%}
                {%- endif ~%}
                {{ html(asset(button.image), {class, alt: button.name ~ ' button'}) }}
              </a>
            {%- endfor ~%}
            </div>
            <ul id="links" class="mt-4 fade-in">
            {%- for link in ['source', 'documentation', 'demo'] ~%}
              {%- if attribute(site.applanding, link) is defined ~%}
              <li class="flex items-center mt-2 justify-center md:justify-start">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewbox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                </svg>
                <a href="{{ attribute(site.applanding, link) }}" class="font-medium">{{ link|trans }}</a>
              </li>
              {%- endif ~%}
            {%- endfor ~%}
            </ul>
          </div>
          {#- image ~#}
          <div class="basis-1/2">
            {%- if site.applanding.demo is defined ~%}
            <a href="{{ site.applanding.demo }}" title="{% trans %}Go to the demo{% endtrans %}">
            {%- endif ~%}
              {#- the mobile variant (e.g.: `screenshot.mobile.png`) is added through `layouts.images.mobile_suffix` ~#}
              {{ html(asset(site.applanding.screenshot), {class: 'mx-auto lg:mr-0 slide-in-bottom', alt: 'Screenshot'|trans}, {formats: ['webp'], responsive: true}) }}
            {%- if site.applanding.demo is defined ~%}
            </a>
            {%- endif ~%}
          </div>
        </div>
        {%- endblock ~%}